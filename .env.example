# FishBench environment (copy to .env and fill in — never commit .env)
# All optional: with nothing set, offline Denise + local vision run the demo.

# --- LLM (any OpenAI-compatible /chat/completions endpoint) ---
#FISHBENCH_LLM_BASE_URL=https://api.deepseek.com/v1
#FISHBENCH_LLM_API_KEY=sk-...
#FISHBENCH_LLM_MODEL=deepseek-v4.1-flash      # must be >= 4.1 for DeepSeek
#FISHBENCH_LLM_BACKEND=http                   # http | offline (default: http if URL set)

# --- Vision (optional; local heuristic works without it) ---
#FISHBENCH_VISION_BASE_URL=https://api.deepseek.com/v1
#FISHBENCH_VISION_API_KEY=sk-...
#FISHBENCH_VISION_MODEL=deepseek-v4.1-flash
#FISHBENCH_VISION_BACKEND=llm                 # llm | local

# --- Server ---
#FISHBENCH_DATA_DIR=./data                    # where the canon lives
#FISHBENCH_VERBOSE=1                          # request logging
